# Illustrator MCP Configuration
# Copy this file to .env and modify as needed

# Proxy Server Ports
HTTP_PORT=8080
WS_PORT=8081

# Proxy Server Host (for MCP server to connect to)
PROXY_HOST=localhost

# Timeout for script execution (seconds)
TIMEOUT=30

# Startup discovery profile: all (18 tools, default) or core (10 tools)
ILLUSTRATOR_MCP_TOOL_PROFILE=all
